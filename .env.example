OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
# llm_backend: openai | anthropic | mock
LLM_BACKEND=openai
MODEL_NAME=gpt-4o
CHEAP_MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.8
MAX_TURNS=30

INTERVENTION_STRATEGY=rate_based
TENSION_THRESHOLD=3.0
RATE_THRESHOLD=0.05
PERIODIC_INTERVAL=8
HUMAN_CONFIRM_INTERVENTION=false

BOUNDARY_SEMANTIC_THRESHOLD=0.85
BOUNDARY_MAX_RETRY=2

TOOL_MAX_CALLS_PER_TURN=3

MEMORY_MAX_ENTRIES=200
MEMORY_PRUNE_RATIO=0.2

CHROMA_PERSIST_DIR=./chroma_db
# vector_store: auto | chroma | naive
VECTOR_STORE=auto
# embedding_backend: auto | openai | hash（hash 为本地确定性回退，适合测试）
EMBEDDING_BACKEND=auto

# trace_backend: auto | local | langfuse
TRACE_BACKEND=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGGRAPH_CHECKPOINT_DIR=./checkpoints

LOG_LEVEL=INFO

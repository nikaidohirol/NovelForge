{
  "name": "novelforge",
  "version": "3.0.0",
  "description": "NovelForge — 二次元轻小说创作工作台",
  "author": "NovelForge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.14"
    }
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/prepare-native-for-electron.mjs",
    "dev": "vite",
    "clean:build": "node scripts/clean-build-output.mjs",
    "prepare:native-node": "node scripts/prepare-native-for-node.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "test": "vitest run",
    "test:eval": "vitest run test/eval",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:renderer-surface:e2e": "node scripts/renderer-surface-e2e.mjs",
    "build": "tsc && vite build",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "node scripts/prepare-native-for-electron.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lancedb/lancedb": "0.22.3",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.9",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "electron-updater": "6.8.9",
    "flatbuffers": "^25.9.23",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "reflect-metadata": "^0.2.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "playwright": "^1.59.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "0.22.3",
    "@lancedb/lancedb-darwin-x64": "0.22.3",
    "@lancedb/lancedb-win32-x64-msvc": "0.22.3"
  }
}

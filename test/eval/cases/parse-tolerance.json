    ],
    "offlineOutput": "<tool_call>\n好的，调用读取。\n{\"name\":\"read_blueprint\",\"arguments\":{\"chapter_number\":3}}\n</tool_call>",
    "expect": {
      "toolCalls": [{ "name": "read_blueprint", "arguments": { "chapter_number": 3 } }],
      "textParts": []
    }
  },
  {

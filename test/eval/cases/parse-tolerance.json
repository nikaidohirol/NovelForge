[
  {
    "id": "parse-xml-01",
    "category": "parse_tolerance",
    "layer": "offline",
    "title": "标准 XML 标签包裹的 JSON 工具调用，前后散文正确分离",
    "tools": [
      {
        "name": "read_blueprint",
        "description": "读取指定章节的蓝图",
        "result": "第 2 章蓝图内容"
      }
    ],
    "offlineOutput": "我先查看第 2 章的蓝图。\n<tool_call>\n{\"name\":\"read_blueprint\",\"arguments\":{\"chapter_number\":2}}\n</tool_call>",
    "expect": {
      "toolCalls": [{ "name": "read_blueprint", "arguments": { "chapter_number": 2 } }],
      "textParts": ["我先查看第 2 章的蓝图。"]
    }
  },
  {
    "id": "parse-xml-02",
    "category": "parse_tolerance",
    "layer": "offline",
    "title": "连续两个 XML 工具调用按顺序解析，无散文残留",
    "tools": [
      { "name": "list_chapters", "description": "列出全部章节", "result": "章节列表" },
      { "name": "read_blueprint", "description": "读取指定章节的蓝图", "result": "蓝图内容" }
    ],
    "offlineOutput": "<tool_call>{\"name\":\"list_chapters\",\"arguments\":{}}</tool_call><tool_call>{\"name\":\"read_blueprint\",\"arguments\":{\"chapter_number\":1}}</tool_call>",
    "expect": {
      "toolCalls": [
        { "name": "list_chapters", "arguments": {} },
        { "name": "read_blueprint", "arguments": { "chapter_number": 1 } }
      ],
      "textParts": []
    }
  },
  {
    "id": "parse-xml-03",
    "category": "parse_tolerance",
    "layer": "offline",
    "title": "tool_call 标签内 JSON 前混入散文时仍可容错提取",
